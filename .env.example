# Copy to .env.local for local development. Everything is optional in dev: without provider keys the app runs
# in PROVIDERS_MODE=mock (deterministic fakes, real FFmpeg media), MockStripe and a logged email outbox.
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
APP_SECRET=dev-secret-dev-secret-dev-secret-0000

# Postgres 16. The owner runs migrations; runtime roles are created by `pnpm db:migrate` (dev passwords = role names).
DATABASE_URL=postgres://dev:dev@localhost:5432/arkiv
APP_DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/arkiv
ADMIN_DATABASE_URL=postgres://admin_rw:admin_rw@localhost:5432/arkiv
# SYSTEM_DATABASE_URL=postgres://system_rw:system_rw@localhost:5432/arkiv   # direct connection (LISTEN)
# DB_PGBOUNCER=1                                                           # when APP/ADMIN go through a transaction pool

PROVIDERS_MODE=mock
# ANTHROPIC_API_KEY=
# ARK_API_KEY=            # BytePlus ModelArk (Seedream images, Seedance video)
# MINIMAX_API_KEY=        # voiceover; BytePlus speech is the fallback
# BYTEPLUS_SPEECH_APP_ID=
# BYTEPLUS_SPEECH_TOKEN=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage/files
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_REGION=nyc3
# SPACES_BUCKET=
# SPACES_KEY=
# SPACES_SECRET=

# STRIPE_SECRET_KEY=      # unset → MockStripe (/checkout/mock/…)
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_STANDALONE=
# STRIPE_PRICE_LAUNCH=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_SCALE=

# RESEND_API_KEY=         # unset → emails logged; EMAIL_DEV_FILE also writes a JSONL outbox
# RESEND_WEBHOOK_SECRET=
# EMAIL_DEV_FILE=/absolute/path/.storage/mail.jsonl

# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / APPLE_CLIENT_ID= / APPLE_TEAM_ID= / APPLE_KEY_ID= / APPLE_PRIVATE_KEY=
# SHOPIFY_API_KEY= / SHOPIFY_API_SECRET= / META_APP_ID= / META_APP_SECRET= / TIKTOK_APP_ID= / TIKTOK_APP_SECRET=
# Turnstile (set both or neither): TURNSTILE_SITE_KEY is public, TURNSTILE_SECRET verifies tokens.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
